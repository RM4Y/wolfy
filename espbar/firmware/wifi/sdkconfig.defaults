# EspBar on two ESP32, the Wi-Fi one: Wi-Fi to Wolfy, UART2 (TX2 / D34) + EN / BOOT to the
# Bluetooth ESP32, which it updates with the program it carries: through that program (OTA), or
# through its ROM bootloader (esp-serial-flasher) when GPIO0 is wired
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
# an update from Wolfy that crashes before linking to it is undone at the next reset
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

# wss:// to Wolfy (wolfy.rm4.fr): Let's Encrypt checked with the CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_SERIAL_FLASHER_PORT_UART=y
CONFIG_SERIAL_FLASHER_LOG_LEVEL_WARN=y

# setup page (setup.c): phones send long headers when checking for a captive portal
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# build id in its HELLO: BT_ID_LEN (16) hex chars of the ELF SHA-256 (9 by default)
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
