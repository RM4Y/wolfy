# EspBar on two ESP32, the Bluetooth one: Bluetooth Classic through BTstack (controller only,
# VHCI), the radio all to the Wii Remotes (no Wi-Fi). Its UART0 (TX0 / RX0) goes to the Wi-Fi
# ESP32, which updates it through them (OTA, or its ROM bootloader when GPIO0 is wired too):
# no console, no boot messages on it.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# an update that doesn't come up (no frame from the Wi-Fi ESP32) is undone at the next reset
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=4
CONFIG_BTSTACK_AUDIO=n

# build id in its HELLO: BT_ID_LEN (16) hex chars of the ELF SHA-256 (9 by default)
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
