 Module::Interface::~Interface() = default;
 
+namespace {
+// profile manager of the running account service, for OpenPreselectedUser
+std::weak_ptr<ProfileManager> g_profile_manager;
+} // namespace
+
+void OpenPreselectedUser(const Common::UUID& uuid) {
+    const auto profile_manager = g_profile_manager.lock();
+    if (!profile_manager || !uuid.IsValid()) {
+        return;
+    }
+    const auto index = profile_manager->GetUserIndex(uuid);
+    if (!index) {
+        LOG_WARNING(Service_ACC, "unknown preselected user uuid=0x{}", uuid.RawString());
+        return;
+    }
+    for (const auto& open : profile_manager->GetOpenUsers()) {
+        if (open.IsValid()) {
+            profile_manager->CloseUser(open);
+        }
+    }
+    profile_manager->OpenUser(uuid);
+    Settings::values.current_user = static_cast<s32>(*index);
+    LOG_INFO(Service_ACC, "open user is now uuid=0x{} (index {})", uuid.RawString(), *index);
+}
+
 void LoopProcess(Core::System& system) {
     auto module = std::make_shared<Module>();
     auto profile_manager = std::make_shared<ProfileManager>();
+    g_profile_manager = profile_manager;
     auto server_manager = std::make_unique<ServerManager>(system);
 
     server_manager->RegisterNamedService("acc:aa",
