+// Held by the HOME menu while it starts an application: background deliveries stay suspended
+// until it is released. This backend has no deliveries, so they are suspended from the start:
+// the event the menu waits on before launching is already signaled.
+class IDeliveryTaskSuspensionService final : public ServiceFramework<IDeliveryTaskSuspensionService> {
+public:
+    explicit IDeliveryTaskSuspensionService(Core::System& system_)
+        : ServiceFramework{system_, "IDeliveryTaskSuspensionService"},
+          service_context{system_, "IDeliveryTaskSuspensionService"} {
+        static const FunctionInfo functions[] = {
+            {0, D<&IDeliveryTaskSuspensionService::GetEvent>, "GetEvent"},
+        };
+        RegisterHandlers(functions);
+        event = service_context.CreateEvent("IDeliveryTaskSuspensionService:Event");
+        event->Signal(system_.Kernel());
+    }
+
+    ~IDeliveryTaskSuspensionService() override {
+        service_context.CloseEvent(event);
+    }
+
+private:
+    Result GetEvent(OutCopyHandle<Kernel::KReadableEvent> out_event) {
+        LOG_INFO(Service_BCAT, "called");
+        *out_event = std::addressof(event->GetReadableEvent());
+        R_SUCCEED();
+    }
+
+    KernelHelpers::ServiceContext service_context;
+    Kernel::KEvent* event{};
+};
