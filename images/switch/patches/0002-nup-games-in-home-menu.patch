+#include "core/file_sys/vfs/vfs_vector.h"
+
+// NUP games of the game folders, for the HOME menu. They hold no NCA, so they are kept out of the
+// content providers (whose users would open them as NCAs): the game list fills this registry, and
+// the ns services read it to list the games with their title and icon.
+namespace FileSys::NupMenu {
+
+struct Entry {
+    std::string path;
+    NACP control;
+    std::vector<u8> icon; // JPEG the HOME menu can show
+};
+
+namespace Detail {
+inline std::mutex mutex;
+inline std::map<u64, Entry> entries;
+} // namespace Detail
+
+inline void Clear() {
+    std::scoped_lock lock{Detail::mutex};
+    Detail::entries.clear();
+}
+
+inline void Add(u64 title_id, Entry entry) {
+    std::scoped_lock lock{Detail::mutex};
+    Detail::entries.insert_or_assign(title_id, std::move(entry));
+}
+
+inline std::vector<u64> TitleIds() {
+    std::scoped_lock lock{Detail::mutex};
+    std::vector<u64> ids;
+    ids.reserve(Detail::entries.size());
+    for (const auto& [title_id, entry] : Detail::entries) {
+        ids.push_back(title_id);
+    }
+    return ids;
+}
+
+/// NACP and icon of a NUP game, nullopt for any other title.
+inline std::optional<std::pair<std::unique_ptr<NACP>, VirtualFile>> Control(u64 title_id) {
+    std::scoped_lock lock{Detail::mutex};
+    const auto it = Detail::entries.find(title_id);
+    if (it == Detail::entries.end()) {
+        return std::nullopt;
+    }
+    VirtualFile icon;
+    if (!it->second.icon.empty()) {
+        icon = std::make_shared<VectorVfsFile>(it->second.icon, "icon.jpg");
+    }
+    return std::make_pair(std::make_unique<NACP>(it->second.control), std::move(icon));
+}
+
+} // namespace FileSys::NupMenu
