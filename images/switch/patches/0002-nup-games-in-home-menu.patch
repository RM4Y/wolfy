+namespace {
+// The HOME menu takes 256x256 JPEG icons in a buffer sized for them; Switch 2 icons can be larger.
+std::vector<u8> NupMenuIcon(const std::vector<u8>& data) {
+    const auto image = QImage::fromData(data.data(), static_cast<int>(data.size()));
+    if (image.isNull()) {
+        return {};
+    }
+    QByteArray jpeg;
+    QBuffer buffer(&jpeg);
+    buffer.open(QIODevice::WriteOnly);
+    image.convertToFormat(QImage::Format_RGB888)
+        .scaled(256, 256, Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
+        .save(&buffer, "JPEG", 90);
+    return {jpeg.begin(), jpeg.end()};
+}
