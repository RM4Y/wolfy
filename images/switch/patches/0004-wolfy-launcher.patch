 Result CreateGuestApplication(SharedPointer<IApplicationAccessor>* out_application_accessor, Core::System& system, WindowSystem& window_system, u64 program_id) {
+    // Under Wolfy's launcher the game runs in a process of its own: the menu tracks a
+    // placeholder of it (a failed start is fatal to the menu).
+    if (FileSys::WolfyLauncher::RequestLaunch(program_id, Settings::values.current_user.GetValue())) {
+        // Its control data and launch properties, as a real start registers them: the menu reads
+        // them through the accessor to resume the game.
+        {
+            FileSys::PatchManager pm{program_id, system.GetFileSystemController(),
+                                     system.GetContentProviderUnion()};
+            const auto metadata = pm.GetControlMetadata();
+            std::vector<u8> control = metadata.first != nullptr
+                                          ? metadata.first->GetRawBytes()
+                                          : std::vector<u8>(sizeof(FileSys::RawNACP), 0);
+            Service::Glue::ApplicationLaunchProperty launch{};
+            launch.title_id = program_id;
+            launch.version = pm.GetGameVersion().value_or(0);
+            auto& arp = system.GetARPManager();
+            static_cast<void>(arp.Unregister(program_id));
+            static_cast<void>(arp.Register(program_id, launch, std::move(control)));
+        }
+        auto placeholder = std::make_unique<Process>(system);
+        placeholder->MakePlaceholder();
+        const auto applet = std::make_shared<Applet>(system, std::move(placeholder), true);
+        applet->program_id = program_id;
+        applet->applet_id = AppletId::Application;
+        applet->type = AppletType::Application;
+        applet->library_applet_mode = LibraryAppletMode::AllForeground;
+        // Running for the window system (no process holder watches it): it goes foreground,
+        // background and suspended like a game, which the menu needs to resume it.
+        applet->is_process_running = true;
+        window_system.TrackApplet(applet, true);
+        *out_application_accessor =
+            std::make_shared<IApplicationAccessor>(system, applet, window_system);
+        R_SUCCEED();
+    }
+
     FileSys::VirtualFile nca_raw{};
 
     // Get the program NCA from storage.
