diff --git a/src/core/file_sys/wolfy_launcher.h b/src/core/file_sys/wolfy_launcher.h
new file mode 100644
index 0000000..1e2f7c2
--- /dev/null
+++ b/src/core/file_sys/wolfy_launcher.h
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <utility>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+// Wolfy's launcher (images/switch2/lichii/wolfy-launcher.py) runs the HOME menu and each game in
+// processes of their own: a game then boots like on its own (Switch 1 or Switch 2 mode, its
+// counter), and nothing of it outlives it. In the menu, the game is a placeholder application
+// (no guest code), so the menu shows it suspended, resumes and closes it as usual. They talk
+// through files in WOLFY_LAUNCHER_DIR:
+//   menu -> launcher: "launch" (program id, user index, path), "resume" (program id): the menu
+//                     brought the game to the foreground, "close": the menu closed it
+//   game -> launcher: "home": HOME was pressed
+//   launcher -> menu: "menu-home": HOME was pressed in the game, "game-ended": the game is gone
+// WOLFY_LAUNCHER_ROLE is "menu" or "game". Without these variables Lichii behaves as usual.
+namespace FileSys::WolfyLauncher {
+
+namespace Detail {
+inline std::mutex mutex;
+inline std::map<u64, std::string> paths; // program id -> file of the game folders
+
+inline const char* Dir() {
+    static const char* const dir = std::getenv("WOLFY_LAUNCHER_DIR");
+    return dir != nullptr && dir[0] != '\0' ? dir : nullptr;
+}
+
+inline std::string_view Role() {
+    static const char* const role = std::getenv("WOLFY_LAUNCHER_ROLE");
+    return role != nullptr ? role : "";
+}
+
+/// Writes `name` in the launcher's folder at once (a temporary file renamed), so the launcher
+/// never reads half of it.
+inline bool Write(const char* name, const std::string& content) {
+    const std::filesystem::path dir{Dir()};
+    const auto tmp = dir / (std::string{name} + ".tmp");
+    {
+        std::ofstream out{tmp, std::ios::trunc};
+        if (!out) {
+            return false;
+        }
+        out << content;
+    }
+    std::error_code ec;
+    std::filesystem::rename(tmp, dir / name, ec);
+    return !ec;
+}
+} // namespace Detail
+
+inline bool IsMenu() {
+    return Detail::Dir() != nullptr && Detail::Role() == "menu";
+}
+
+inline bool IsGame() {
+    return Detail::Dir() != nullptr && Detail::Role() == "game";
+}
+
+inline void ClearPaths() {
+    std::scoped_lock lock{Detail::mutex};
+    Detail::paths.clear();
+}
+
+inline void SetPath(u64 program_id, std::string path) {
+    std::scoped_lock lock{Detail::mutex};
+    Detail::paths.insert_or_assign(program_id, std::move(path));
+}
+
+/// The HOME menu starts a game: hand it to the launcher. False when the menu is not under the
+/// launcher or the game has no file (installed in the NAND): it then runs inside the menu.
+inline bool RequestLaunch(u64 program_id, s32 user_index) {
+    if (!IsMenu()) {
+        return false;
+    }
+    std::scoped_lock lock{Detail::mutex};
+    const auto it = Detail::paths.find(program_id);
+    if (it == Detail::paths.end()) {
+        LOG_WARNING(Service_AM, "Wolfy launcher: no file for {:016X}, started in the menu",
+                    program_id);
+        return false;
+    }
+    if (!Detail::Write("launch", fmt::format("{:016X}\n{}\n{}\n", program_id, user_index,
+                                             it->second))) {
+        LOG_ERROR(Service_AM, "Wolfy launcher: can't write the launch request");
+        return false;
+    }
+    LOG_INFO(Service_AM, "Wolfy launcher: {:016X} (user {}) -> {}", program_id, user_index,
+             it->second);
+    return true;
+}
+
+/// The menu brought the game to the foreground (started or resumed from its suspended tile).
+inline void NotifyForeground(u64 program_id) {
+    if (IsMenu()) {
+        Detail::Write("resume", fmt::format("{:016X}\n", program_id));
+    }
+}
+
+/// The menu closed the game ("Close software", or another game picked).
+inline void NotifyClose(u64 program_id) {
+    if (IsMenu()) {
+        Detail::Write("close", fmt::format("{:016X}\n", program_id));
+        LOG_INFO(Service_AM, "Wolfy launcher: {:016X} closed by the menu", program_id);
+    }
+}
+
+/// A request of the launcher to the menu ("menu-home", "game-ended"), removed once taken.
+inline bool TakeMenuRequest(const char* name) {
+    if (!IsMenu()) {
+        return false;
+    }
+    std::error_code ec;
+    return std::filesystem::remove(std::filesystem::path{Detail::Dir()} / name, ec);
+}
+
+/// HOME in a game process: the launcher pauses the game and shows the menu.
+inline bool RequestHome() {
+    if (!IsGame()) {
+        return false;
+    }
+    Detail::Write("home", "home\n");
+    LOG_INFO(Service_AM, "Wolfy launcher: HOME, back to the menu");
+    return true;
+}
+
+} // namespace FileSys::WolfyLauncher
