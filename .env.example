# Mot de passe de l'interface (obligatoire)
WOLFY_ADMIN_PASSWORD=change-moi
# Durée de la session de connexion, en heures
WOLFY_SESSION_HOURS=168
# Valeurs par défaut adaptées à /opt/stacks/wolf ; à changer seulement si Wolf est ailleurs
#WOLF_CONTAINER=wolf
#WOLF_SOCKET=/var/run/wolf/wolf.sock
#WOLF_STATE_DIR=/opt/stacks/config/wolf
#WOLF_IMAGES_DIR=/opt/stacks/wolf/images
#WOLF_DEFAULT_PROFILE=moonlight-profile-id

# Chemin du projet sur le serveur (les données des émulateurs sont dans <ce dossier>/config)
WOLFY_DIR=/home/remy/Bureau/wolfy
